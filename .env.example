# Mentora — Environment Variables
# Copy this file to .env and fill in your API key

# LLM Provider: "groq" (default, ultra-fast sub-second turns) | "gemini" | "openai"
LLM_PROVIDER=groq

# Groq API Key (Recommended default — free at https://console.groq.com/keys)
# Powers both LLaMA 3.3 70B Versatile and Whisper Large v3 Turbo audio transcription
GROQ_API_KEY=your_groq_api_key_here

# Optional: Google Gemini API Key (alternative provider — https://aistudio.google.com/apikey)
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (alternative provider — https://platform.openai.com/api-keys)
# OPENAI_API_KEY=your_openai_api_key_here

